PORT=4000
# Neon: 런타임 쿼리용 pooled 연결 (호스트에 -pooler가 붙는다). Vercel Functions는 항상 이걸 사용.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/db?sslmode=require
# Neon: 마이그레이션 전용 direct(unpooled) 연결 (호스트에 -pooler 없음). prisma migrate/db push에만 사용.
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/db?sslmode=require
JWT_SECRET=change-me
CRON_SECRET=change-me
WEB_ORIGIN=http://localhost:3000

KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=

# firebase-admin 서비스 계정 JSON 전체를 한 줄 문자열로 저장
FIREBASE_SERVICE_ACCOUNT_JSON=
