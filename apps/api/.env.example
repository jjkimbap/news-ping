PORT=4000
# Neon: 런타임 쿼리용 pooled 연결 (호스트에 -pooler가 붙는다). Vercel Functions는 항상 이걸 사용.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/db?sslmode=require
# Neon: 마이그레이션 전용 direct(unpooled) 연결 (호스트에 -pooler 없음). prisma migrate/db push에만 사용.
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/db?sslmode=require

JWT_SECRET=change-me
CRON_SECRET=change-me
WEB_ORIGIN=http://localhost:3000

# REST API 키를 사용해야 함 (Native/JavaScript/Admin 키 아님)
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=
# 카카오 디벨로퍼스 > 카카오 로그인 > 보안 > Client Secret 을 활성화한 경우에만 발급되는 값. 비활성화 시 비워둘 것.
KAKAO_CLIENT_SECRET=

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=

# firebase-admin 서비스 계정 JSON 전체를 한 줄 문자열로 저장 (Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성)
# dotenv는 멀티라인 값을 지원하지 않으므로 반드시 한 줄로 압축해서 넣을 것.
FIREBASE_SERVICE_ACCOUNT_JSON=
